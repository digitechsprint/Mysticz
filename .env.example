# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret - server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
