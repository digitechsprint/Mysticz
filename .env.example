# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret - server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Email notifications for Contact / Book-a-Consultation form submissions.
# Get a free API key at https://resend.com. Leave unset to skip emailing
# (leads still save to the database either way).
RESEND_API_KEY=
# Defaults to site.email (mysticz.bhavika@gmail.com) if unset.
LEAD_NOTIFICATION_EMAIL=
# Must be a domain verified in Resend, or their sandbox onboarding@resend.dev address.
RESEND_FROM_EMAIL=
